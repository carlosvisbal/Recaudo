# Copie este archivo a .env y ajuste los valores.

# Django
DJANGO_SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8010,http://127.0.0.1:8010
RECAUDO_PORT=8010

# Administrador único (se crea una vez, al migrar las tablas)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Skorpion18***
ADMIN_EMAIL=admin@localhost

# Base de datos: SQLite (Docker local y Railway con volumen en /data).
SQLITE_PATH=/app/data/db.sqlite3

# En Railway no ponga un dominio propio: use Generate Domain (*.up.railway.app).
# Monte un Volume en /data. No hace falta SQLITE_PATH ni MEDIA_ROOT; se usan solos.
# Si más adelante agrega el plugin Postgres, Railway define DATABASE_URL y se usa eso.

# PostgreSQL opcional (local). Si define POSTGRES_HOST, Django lo usa en vez de SQLite.
# POSTGRES_DB=recaudo
# POSTGRES_USER=recaudo
# POSTGRES_PASSWORD=
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# DATABASE_URL=

# Organización (también editable en Configuración)
ORGANIZATION_NAME=Organización de Recaudos

# Correo (opcional). Si no se configura, la app abre el cliente de correo del dispositivo.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=

# Zona horaria
TZ=America/Bogota

# Cloudflare Tunnel con URL fija (recomendado)
# El túnel rápido (*.trycloudflare.com) cambia de enlace cada vez que arranca cloudflared.
# Para el mismo hostname siempre:
# 1. Cuenta Cloudflare + un dominio en esa cuenta.
# 2. Zero Trust → Networks → Tunnels → Create → Cloudflared. Copie el token.
# 3. Public Hostname: recaudo.sudominio.com → HTTP → http://app:8000
# 4. Ponga el token y el hostname aquí. docker compose up -d cloudflared
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_PUBLIC_HOST=
